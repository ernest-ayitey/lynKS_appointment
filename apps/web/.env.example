# Base URL the SPA prefixes onto API request paths (see src/lib/api-client.ts).
#
# Leave this UNSET for the standard local setup: `npm run dev:web` proxies
# /auth and /health to the API on http://localhost:3000 (see the `server.proxy`
# block in vite.config.ts), so same-origin requests already reach the API.
#
# Set it only when the API is not reachable through that proxy — e.g. a
# deployed API, a non-default API port, or a static `npm run build` preview
# with no dev server in front of it. The API must then allow this app's
# origin via its own CORS_ORIGIN setting (see apps/api/.env.example).
# VITE_API_BASE_URL="http://localhost:3000"
