generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in `prisma.config.ts` (Prisma 7) — see
// `datasource.url` there, not here.
datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Clinic / locations
// ---------------------------------------------------------------------------

model Clinic {
  id        String     @id @default(cuid())
  name      String
  timezone  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  locations Location[]
}

model Location {
  id        String   @id @default(cuid())
  clinicId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic             Clinic              @relation(fields: [clinicId], references: [id])
  staffUserLocations StaffUserLocation[]

  @@index([clinicId])
}

// ---------------------------------------------------------------------------
// Roles / permissions (RBAC)
// ---------------------------------------------------------------------------

model Role {
  id              String   @id @default(cuid())
  name            String   @unique
  isSystemDefault Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  staffUsers      StaffUser[]
  rolePermissions RolePermission[]
}

model Permission {
  id  String @id @default(cuid())
  key String @unique

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String  @id @default(cuid())
  roleId       String
  permissionId String
  allowed      Boolean

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

// ---------------------------------------------------------------------------
// Staff users
// ---------------------------------------------------------------------------

model StaffUser {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  // Unique because staff 2-step verification binds an OTP to a staff
  // user by its destination phone number — two staff rows sharing a
  // phone would make that identity check meaningless.
  phone          String    @unique
  passwordHash   String
  roleId         String
  twoStepEnabled Boolean   @default(false)
  deactivatedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  role               Role                @relation(fields: [roleId], references: [id])
  staffUserLocations StaffUserLocation[]

  @@index([roleId])
}

model StaffUserLocation {
  id          String @id @default(cuid())
  staffUserId String
  locationId  String

  staffUser StaffUser @relation(fields: [staffUserId], references: [id])
  location  Location  @relation(fields: [locationId], references: [id])

  @@unique([staffUserId, locationId])
  @@index([locationId])
}

// ---------------------------------------------------------------------------
// Patients
// ---------------------------------------------------------------------------

model Account {
  id            String    @id @default(cuid())
  phone         String    @unique
  email         String?   @unique
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  patientProfiles PatientProfile[]
}

enum PatientRelationship {
  SELF
  CHILD
  DEPENDENT
}

model PatientProfile {
  id           String              @id @default(cuid())
  accountId    String
  firstName    String
  lastName     String
  dateOfBirth  DateTime
  relationship PatientRelationship
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
}

// ---------------------------------------------------------------------------
// Auth support (OTP, refresh tokens, audit log)
// ---------------------------------------------------------------------------

enum OtpPurpose {
  PATIENT_LOGIN
  STAFF_TWO_STEP
}

model OtpCode {
  id          String     @id @default(cuid())
  destination String
  purpose     OtpPurpose
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int        @default(0)
  createdAt   DateTime   @default(now())

  @@index([destination, purpose])
}

enum RefreshTokenSubjectType {
  ACCOUNT
  STAFF
}

// subjectId is a polymorphic reference to either Account.id or StaffUser.id
// depending on subjectType — intentionally not a DB-level foreign key.
model RefreshToken {
  id          String                  @id @default(cuid())
  subjectType RefreshTokenSubjectType
  subjectId   String
  tokenHash   String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime                @default(now())

  @@index([subjectType, subjectId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorType, actorId])
}
